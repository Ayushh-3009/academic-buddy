# ==============================================================================
# ACADEMIC BUDDY - ENVIRONMENT CONFIGURATION
# Copy this file to .env and fill in your values
# ==============================================================================

# Server Configuration
PORT=3000
NODE_ENV=development
CLIENT_URL=http://localhost:3000

# Google Gemini AI Configuration
# Get your free API key at: https://aistudio.google.com/
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-2.0-flash
GEMINI_MAX_OUTPUT_TOKENS=1500
GEMINI_TEMPERATURE=0.7

# Security & Authentication
JWT_SECRET=academic_buddy_super_secret_jwt_key_change_in_production_2026
JWT_EXPIRES_IN=7d

# Rate Limiting & Safety Guardrails
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX_PER_WINDOW=20
MAX_MESSAGE_LENGTH=3000

# Database Storage Path
DATABASE_PATH=./data/academic_buddy.sqlite
